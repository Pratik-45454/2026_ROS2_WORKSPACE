            <RetryUntilSuccessful num_attempts="-1">
                <GripperAct state="-0.1"/>
            </RetryUntilSuccessful>

            <RetryUntilSuccessful num_attempts="-1">
                <GripperPose angle="1.8"/>
            </RetryUntilSuccessful>
        </Sequence>        
    </BehaviorTree>

    <BehaviorTree ID="GripperScrollHold">
        <!-- <RetryUntilSuccessful num_attempts="-1">
            <setHeight height="500"/>
        </RetryUntilSuccessful> -->
        <RetryUntilSuccessful num_attempts="-1">
            <GripperPose angle="1.8"/>
        </RetryUntilSuccessful>
    </BehaviorTree>

    <BehaviorTree ID="GripperScrollHold_Arena">
        <RetryUntilSuccessful num_attempts="-1">
            <setHeight height="30"/>
        </RetryUntilSuccessful>
    </BehaviorTree>


    <BehaviorTree ID="GripperScrollStore">
