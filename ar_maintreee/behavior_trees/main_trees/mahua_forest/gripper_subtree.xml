    <BehaviorTree ID="GripperArenaPlace_Ready">
        <Sequence>
            <DecisionGripperHeight name="Decide arena place height"
                store_place ="1"
                count ="{count}"
                height = "{height}"
            />
            
            <Parallel>
                <Sequence>
                    <RetryUntilSuccessful num_attempts="-1">
                        <setHeight height="22.0"/>
                    </RetryUntilSuccessful>
                    <RetryUntilSuccessful num_attempts="-1">
                        <GripperAct state="0.7"/>
                    </RetryUntilSuccessful>
                    <RetryUntilSuccessful num_attempts="-1">
                        <GripperPose angle="0.0"/>
                    </RetryUntilSuccessful>
                   
                
                </Sequence>
            </Parallel>

           
             <Sequence name="scrollready">
                <RetryUntilSuccessful num_attempts="-1">
                        <GripperAct state="-0.1"/>
                </RetryUntilSuccessful>
                <RetryUntilSuccessful num_attempts="-1">
                    <GripperPose angle="3.75"/>
                </RetryUntilSuccessful>
                <RetryUntilSuccessful num_attempts="-1">
                        <setHeight height="22.0"/>
                </RetryUntilSuccessful>      
            </Sequence>
            
        </Sequence>        
    </BehaviorTree>

    <BehaviorTree ID="GripperArenaPlace">
        <Sequence name="placingInArena">
            <Move name="moveforplace" move_x="50.0" move_y="0.0"
                        x_kp="0.009" x_ki="0.0" x_kd="0.003"
                        y_kp="0.002" y_ki="0.0" y_kd="0.001"/>
            <RetryUntilSuccessful num_attempts="-1">
                    <GripperAct state="0.7"/>
            </RetryUntilSuccessful>
            <RetryUntilSuccessful num_attempts="-1">
                    <setHeight height="10.0"/>
            </RetryUntilSuccessful>   

           <RetryUntilSuccessful num_attempts="-1">
                <GripperPose angle="3.75"/>
            </RetryUntilSuccessful>      
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="GripperEntraceScrollPick_Ready">
        <Sequence>
            <Parallel>
                <RetryUntilSuccessful num_attempts="-1">
                    <setHeight height="0.0"/>
                </RetryUntilSuccessful>
                <RetryUntilSuccessful num_attempts="-1">
                    <GripperPose angle="3.75"/>
                </RetryUntilSuccessful>
                <RetryUntilSuccessful num_attempts="-1">
                    <GripperAct state="0.7"/>
                </RetryUntilSuccessful>
            </Parallel>

        </Sequence>        
    </BehaviorTree>

    <BehaviorTree ID="GripperGroundScrollPick_Ready">
        <Sequence>
            <Parallel>
                <RetryUntilSuccessful num_attempts="-1">
                    <setHeight height="330.0"/>
                </RetryUntilSuccessful>
                <RetryUntilSuccessful num_attempts="-1">
                    <GripperPose angle="3.75"/>
                </RetryUntilSuccessful>
                <RetryUntilSuccessful num_attempts="-1">
                    <GripperAct state="0.7"/>
                </RetryUntilSuccessful>
            </Parallel>

        </Sequence>        
    </BehaviorTree>

</root>
