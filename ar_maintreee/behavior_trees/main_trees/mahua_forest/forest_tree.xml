<?xml version="1.0"?>
<root BTCPP_format="4">
  <BehaviorTree ID="ForestTree">
      <Sequence name="RootSequence">

        <PlanPath name="PlanPathToForest"
          stage1_detections="{stage1_detections}"
          stage2_detections="{stage2_detections}"
          stage3_detections="{stage3_detections}"
          stage4_detections="{stage4_detections}"
          path="{path}"
          ar_nodes="{ar_nodes}"
          goal_node="{goal_node}"
        />

        <NodeAnalysis name="NodeAnalysis"
          path="{path}"
          ar_nodes="{ar_nodes}"
          merged_path="{merged_path}"
          node_state="{node_state}"
        />

        <Sequence>
          <Inverter>
            <KeepRunningUntilFailure name="MainLoop">
              <Sequence name="MainSequence">
                <IsInsideForest/>
                <DecisionNode name="DecisionNode"
                  merged_path="{merged_path}"
                  node_state="{node_state}"
                  curr_node="{curr_node}"
                  next_node="{next_node}"
                  prev_node="{prev_node}"
                  climb_state="{climb_state}"
                  next_climb_state="{next_climb_state}"
                  rotate_state="{rotate_state}"
                  move_x="{move_x}"
                  move_y="{move_y}"
                  curr_node_state="{curr_node_state}"
                  next_node_state="{next_node_state}"
                  color="{color}"
                  trust="{trust}"
                  turn="{turn}"
                />

                <IfThenElse>
                  <CheckforC name="CheckforC" next_node_state="{next_node_state}"/>
                  <Sequence name="Sequence1">

                      <Move name="Move" move_x="{move_x}" move_y="{move_y}"
                       x_kp="0.009" x_ki="0.0" x_kd="0.003"
                      y_kp="0.002" y_ki="0.0" y_kd="0.001"/>
                      <YawSetpoint name="check_for_c_yaw" turn="{turn}" current_yaw="{current_yaw}"/>
                      <Inverter>
                        <KeepRunningUntilFailure name="small_movement">
                          <Sequence name="ProxSeq">
                            <Inverter>
                              <CheckForProx name="CheckForProx"
                                climb_state="{climb_state}"
                                brake_gain_x="10.0"
                                brake_gain_y="-10.0"
                                max_brake_vel="1.0"
                                brake_duration_ms="500"
                                y_direction_flip="false"
                              />
                            </Inverter>
                            <VelPublish name="VelPublish" climb_state="{climb_state}"/>
                          </Sequence>
                        </KeepRunningUntilFailure>
                      </Inverter>

                      <Climb name="Climb" up_down="1"/>
                      <Roll name="Roll" climb_state="{climb_state}"/>
                      <Climb name="Retract" up_down="-1"
                        next_climb_state="{next_climb_state}"
                        climb_state="{climb_state}"/>
                  </Sequence>

                  <IfThenElse>
                    <CheckforS name="CheckforS" next_node_state="{next_node_state}"/>
                    <Sequence name="Sequence2">
                      <Move name="Move" move_x="{move_x}" move_y="{move_y}"
                         x_kp="0.009" x_ki="0.0" x_kd="0.003"
                      y_kp="0.002" y_ki="0.0" y_kd="0.001"/>

                      <Parallel>
                        <YawSetpoint name="check_for_s_yaw" turn="{turn}" current_yaw="{current_yaw}"/>
                        <SubTree ID="GripperScrollPick_Ready" _autoremap="true"/>
                      </Parallel>
                      <Inverter>
                        <KeepRunningUntilFailure name="small_movement">
                          <Sequence name="ProxSeq">
                            <Inverter>
                              <CheckForProx name="CheckForProx"
                                climb_state="{climb_state}"
                                brake_gain_x="10.0"
                                brake_gain_y="-10.0"
                                max_brake_vel="1.0"
                                brake_duration_ms="500"
                                y_direction_flip="false"
                              />
                            </Inverter>
                            <VelPublish name="VelPublish" climb_state="{climb_state}"/>
                          </Sequence>
                        </KeepRunningUntilFailure>
                      </Inverter>

                      <SubTree ID="GripperScrollPick" _autoremap="true"/>

                      <IfThenElse>
                        <Precondition if="count == 2" else="FAILURE">
                            <AlwaysSuccess/>
                        </Precondition>
                        <SubTree ID = "GripperScrollHold"/>
                        <SubTree ID = "GripperScrollStore"/>
                      </IfThenElse>
                      <IncrementalScroll action = "0" count = "{count}"/> 
                    </Sequence>


                    <Sequence name="Sequence3">
                      <Move name="Move" move_x="{move_x}" move_y="{move_y}"
                         x_kp="0.009" x_ki="0.0" x_kd="0.003"
                      y_kp="0.002" y_ki="0.0" y_kd="0.001"/>

                      <Parallel>
                        <YawSetpoint name="sac_yaw" turn="{turn}" current_yaw="{current_yaw}"/>
                        <SubTree ID="GripperScrollPick_Ready" _autoremap="true"/>
                      </Parallel>

                      <Inverter>
                        <KeepRunningUntilFailure name="small_movement">
                          <Sequence name="ProxSeq">
                            <Inverter>
                              <CheckForProx name="CheckForProx"
                                climb_state="{climb_state}"
                                brake_gain_x="10.0"
                                brake_gain_y="-10.0"
                                max_brake_vel="1.0"
                                brake_duration_ms="500"
                                y_direction_flip="false"
                              />
                            </Inverter>
                            <VelPublish name="VelPublish" climb_state="{climb_state}"/>
                          </Sequence>
                        </KeepRunningUntilFailure>
                      </Inverter>

                      <SubTree ID="GripperScrollPick" _autoremap="true"/>
                      <IncrementalScroll action = "0" count = "{count}"/> 
                        <Climb name="Climb" up_down="1"/>
                        <Roll name="Roll" climb_state="{climb_state}"/>
                        <Climb name="Retract" up_down="-1"
                          next_climb_state="{next_climb_state}"
                          climb_state="{climb_state}"/>

                    </Sequence>
                  </IfThenElse>
                </IfThenElse>
              </Sequence>
            </KeepRunningUntilFailure>
          </Inverter>
         
          <SetBlackboard output_key="in_arena" value="1" />
          <SetBlackboard output_key="in_forest" value="0" />
        </Sequence>
      </Sequence>
    </BehaviorTree>
</root>