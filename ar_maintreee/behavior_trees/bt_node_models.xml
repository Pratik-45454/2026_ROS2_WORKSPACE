<root BTCPP_format="4">
    <TreeNodesModel>
        <Action ID="AkClient">
            <input_port name="down" type="bool">Send true to lower the mechanism</input_port>
            <input_port name="up" type="bool">Send true to raise the mechanism</input_port>
        </Action>
        <Action ID="AlignArena">
            <input_port name="target_y" type="float"/>
            <input_port name="target_x" type="float"/>
        </Action>
        <Action ID="AlwaysNode">
            <input_port name="state" type="int"/>
        </Action>
        <Action ID="BrakeTest">
            <input_port name="y_direction_flip" type="bool"/>
            <input_port name="brake_duration_ms" type="int"/>
            <input_port name="max_brake_vel" type="double"/>
            <input_port name="brake_gain_y" type="double"/>
            <input_port name="brake_gain_x" type="double"/>
            <input_port name="move_duration_ms" type="int"/>
            <input_port name="move_vy" type="float"/>
            <input_port name="move_vx" type="float"/>
        </Action>
        <Action ID="CheckForFallenScroll">
            <input_port name="pick_dropped" type="unsigned char"/>
        </Action>
        <Action ID="CheckForProx">
            <input_port name="y_direction_flip" type="bool"/>
            <input_port name="brake_duration_ms" type="int"/>
            <input_port name="max_brake_vel" type="double"/>
            <input_port name="brake_gain_y" type="double"/>
            <input_port name="brake_gain_x" type="double"/>
            <input_port name="climb_state" type="int"/>
        </Action>
        <Condition ID="CheckGoalNode">
            <input_port name="value" type="int"/>
            <input_port name="goal_node" type="int"/>
        </Condition>
        <Action ID="CheckPlaceCondition"/>
        <Action ID="CheckSecondRow"/>
        <Action ID="CheckforC">
            <input_port name="next_node_state" type="int"/>
        </Action>
        <Action ID="CheckforS">
            <input_port name="next_node_state" type="int"/>
        </Action>
        <Action ID="Climb">
            <input_port name="climb_state" type="int" default="1">Current climb direction: UP or DOWN</input_port>
            <input_port name="next_climb_state" type="int">Used for preset roll after retract</input_port>
            <input_port name="up_down" type="int"/>
        </Action>
        <Action ID="DecisionGripperHeight">
            <output_port name="elev_vert_h" type="float">height to reach</output_port>
            <input_port name="count" type="int"/>
            <input_port name="store_place" type="int"/>
            <input_port name="height" type="float"/>
        </Action>
        <Action ID="DecisionNode">
            <output_port name="curr_node" type="int"/>
            <output_port name="next_climb_state" type="int"/>
            <input_port name="node_state" type="std::map&lt;int, int, std::less&lt;int&gt;, std::allocator&lt;std::pair&lt;int const, int&gt; &gt; &gt;"/>
            <input_port name="color" type="std::string"/>
            <output_port name="rotate_state" type="float"/>
            <input_port name="trust" type="unsigned char"/>
            <output_port name="climb_state" type="int"/>
            <output_port name="next_node" type="int"/>
            <input_port name="merged_path" type="std::vector&lt;int, std::allocator&lt;int&gt; &gt;"/>
            <output_port name="prev_node" type="int"/>
            <output_port name="next_node_state" type="int"/>
            <output_port name="curr_node_state" type="int"/>
            <output_port name="turn" type="std::string"/>
            <output_port name="move_x" type="float"/>
            <output_port name="move_y" type="float"/>
        </Action>
        <Action ID="DecisionOdom">
            <input_port name="color" type="std::string">red or blue</input_port>
            <output_port name="turn" type="std::string">Direction you wish the robot to rotate: Right, Left, Back, Front</output_port>
            <input_port name="current_yaw" type="CurrentYaw"/>
            <inout_port name="stage1" type="MartialStageDetections"/>
        </Action>
        <Action ID="DecisionSick">
            <output_port name="turn" type="std::string">Direction you wish the robot to rotate: Right, Left, Back, Front</output_port>
            <output_port name="pick_from_entrance" type="int">Used to decide wether to pickup scroll from the climbing block or just climb</output_port>
            <input_port name="current_yaw" type="CurrentYaw"/>
            <output_port name="under_roi" type="std::string"/>
            <inout_port name="climb_position_reached" type="int">Used to decide wehter the robot as gone to the middle block or not</inout_port>
            <input_port name="store" type="int"/>
            <input_port name="color" type="std::string"/>
            <inout_port name="stage1" type="MartialStageDetections"/>
        </Action>
        <Action ID="FindHiddenScroll">
            <input_port name="stage4" type="MartialStageDetections"/>
            <input_port name="stage3" type="MartialStageDetections"/>
            <input_port name="stage2" type="MartialStageDetections"/>
            <input_port name="stage1" type="MartialStageDetections"/>
        </Action>
        <Action ID="GetROIDetections">
            <output_port name="detections" type="MartialStageDetections"/>
            <input_port name="trigger_roi" type="int" default="1">Stage11 trigger ROI</input_port>
            <input_port name="type" type="int" default="2">1=check specific martial ROI, 2=standard logic</input_port>
            <input_port name="reset_delay_ms" type="int" default="1200">Delay after reset in ms</input_port>
            <input_port name="color" type="std::string" default="red">red=lower ROI, blue=higher ROI</input_port>
            <input_port name="stage" type="int" default="1">Detection stage</input_port>
        </Action>
        <Action ID="GoToEntrance">
            <inout_port name="first_stage_done" type="bool"/>
            <inout_port name="check" type="bool"/>
            <inout_port name="climb_position_reached" type="int"/>
            <input_port name="color" type="std::string">red or blue</input_port>
            <output_port name="turn" type="std::string">Direction: Right, Left, Back, Front or raw float</output_port>
            <input_port name="current_yaw" type="CurrentYaw"/>
            <inout_port name="stage1" type="MartialStageDetections"/>
        </Action>
        <Action ID="GoWait"/>
        <Action ID="GripperAct">
            <input_port name="state" type="float"/>
        </Action>
        <Action ID="GripperPose">
            <input_port name="angle" type="float"/>
        </Action>
        <Action ID="IncrementalScroll">
            <output_port name="count" type="int"/>
            <input_port name="action" type="int"/>
        </Action>
        <Action ID="InitRobot">
            <output_port name="color" type="std::string"/>
        </Action>
        <Action ID="InitializePortsActuators">
            <output_port name="turn" type="std::string"/>
            <output_port name="color" type="std::string"/>
        </Action>
        <Action ID="IsInsideForest"/>
        <Action ID="Move">
            <input_port name="y_ki" type="float" default="0.000000">Y integral gain</input_port>
            <input_port name="y_kp" type="float" default="0.002000">Y proportional gain</input_port>
            <input_port name="y_kd" type="float" default="0.001000">Y derivative gain</input_port>
            <input_port name="x_kd" type="float" default="0.001000">X derivative gain</input_port>
            <input_port name="x_ki" type="float" default="0.000000">X integral gain</input_port>
            <input_port name="x_kp" type="float" default="0.005000">X proportional gain</input_port>
            <input_port name="move_y" type="float"/>
            <input_port name="move_x" type="float"/>
        </Action>
        <Action ID="NodeAnalysis">
            <output_port name="node_state" type="std::map&lt;int, int, std::less&lt;int&gt;, std::allocator&lt;std::pair&lt;int const, int&gt; &gt; &gt;"/>
            <output_port name="merged_path" type="std::vector&lt;int, std::allocator&lt;int&gt; &gt;"/>
            <input_port name="ar_nodes" type="std::vector&lt;int, std::allocator&lt;int&gt; &gt;"/>
            <input_port name="path" type="std::vector&lt;int, std::allocator&lt;int&gt; &gt;"/>
        </Action>
        <Action ID="OdomPIDClient">
            <input_port name="setpoint" type="std::vector&lt;float, std::allocator&lt;float&gt; &gt;">X and Y displacement in mm</input_port>
        </Action>
        <Action ID="PlanPath">
            <output_port name="ar_nodes" type="std::vector&lt;int, std::allocator&lt;int&gt; &gt;"/>
            <output_port name="path" type="std::vector&lt;int, std::allocator&lt;int&gt; &gt;"/>
            <output_port name="goal_node" type="int"/>
            <input_port name="stage4_detections" type="MartialStageDetections"/>
            <input_port name="stage3_detections" type="MartialStageDetections"/>
            <input_port name="stage2_detections" type="MartialStageDetections"/>
            <input_port name="stage1_detections" type="MartialStageDetections"/>
        </Action>
        <Action ID="Roll">
            <input_port name="climb_state" type="int">Climb state: UP=1 or DOWN=0</input_port>
        </Action>
        <Action ID="Rotate">
            <output_port name="final_yaw" type="float">Actual yaw reading when rotation completed</output_port>
            <input_port name="rotate_state" type="float">Target rotation in DEGREES from DecisionNode</input_port>
        </Action>
        <Action ID="SetpointLoader">
            <input_port name="color" type="std::string"/>
        </Action>
        <Action ID="SickPIDClient">
            <input_port name="setpoint" type="std::vector&lt;float, std::allocator&lt;float&gt; &gt;">All 4 sick setpoints</input_port>
        </Action>
        <Action ID="StallDetection">
            <input_port name="threshold" type="float">Delta threshold to count as stall</input_port>
            <input_port name="direction" type="std::string">Left, Right, Front or Back</input_port>
        </Action>
        <Action ID="StartWait"/>
        <Action ID="VelPublish">
            <input_port name="next_climb_state" type="int">Next node climb state, used for preset roll</input_port>
            <input_port name="climb_state" type="int">Climb state: UP or DOWN</input_port>
        </Action>
        <Action ID="WaitForLift"/>
        <Action ID="WaitForSet">
            <output_port name="trust" type="unsigned char"/>
            <output_port name="third_row" type="unsigned char"/>
            <output_port name="row" type="std::string"/>
            <output_port name="second_row" type="unsigned char"/>
            <input_port name="color" type="std::string"/>
            <output_port name="detections_stg_3" type="MartialStageDetections"/>
            <output_port name="pick_dropped" type="unsigned char"/>
            <output_port name="detections_stg_4" type="MartialStageDetections"/>
            <output_port name="detections_stg_2" type="MartialStageDetections"/>
            <output_port name="detections_stg_1" type="MartialStageDetections"/>
        </Action>
        <Action ID="YawSetpoint">
            <inout_port name="current_yaw" type="CurrentYaw" default="json:0">Current facing direction</inout_port>
            <input_port name="turn" type="std::string">Direction: Right, Left, Back, Front or raw float</input_port>
        </Action>
        <Action ID="ZoneChange"/>
        <Action ID="ZoneConfig">
            <output_port name="zone" type="std::string"/>
        </Action>
        <Action ID="isPathClear"/>
        <Action ID="setExtension">
            <input_port name="length" type="float"/>
        </Action>
        <Action ID="setHeight">
            <input_port name="height" type="float"/>
        </Action>
    </TreeNodesModel>
</root>
